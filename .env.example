# ─── Admin auth ───────────────────────────────────────────────────────────────
# Set both to enable the admin dashboard. Login at /admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-deploying

# ─── Supabase (optional — app runs in dev/memory mode without these) ──────────
# Create a project at https://supabase.com, then find these in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Gemini (optional — uses placeholder images without this) ─────────────────
# Get an API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Stripe (optional — uses simulated checkout without this) ─────────────────
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Set this after creating a webhook endpoint in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend (optional — emails are logged to console without this) ────────────
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_...
# The from-address for outgoing emails (must be a verified domain in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Site URL (required for absolute URLs in emails and Stripe redirects) ─────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ─── Dev override (force mock generation even when Gemini key is set) ─────────
# DEV_MOCK_GENERATION=true
